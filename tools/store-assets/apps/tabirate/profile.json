    "text": "#16211F",
    "body": "#5B6764",
    "icon": "../../../../assets/images/icon.png",
    "deep": "#0B7F75",
    "deepAlt": "#08524D",
    "onDeepAccent": "#A8EDE2",
    "warm": "#FBF1DE",
    "accentSoft": "#FBF1DE",
    "accentText": "#9A6516"
  },
  "outDir": "../../out",
  "draftWatermark": "DRAFT · Web版プレビュー · 提出不可",
  "features": {
    "camera-ocr": {
      "status": "released",
      "label": "カメラで値札の価格を読み取る（端末内OCR）"
    },
    "jpy-conversion": {
      "status": "released",
      "label": "日本円への換算"
    },
    "multi-currency": {
      "status": "released",
      "label": "複数通貨"
    },
    "manual-convert": {
      "status": "released",
      "label": "手入力の換算"
    },
    "records": {
      "status": "released",
      "label": "買い物候補・購入済みの記録"
    },
    "trips": {
      "status": "released",
      "label": "旅行ごとの記録"
    },
    "calendar": {
      "status": "released",
      "label": "買い物カレンダー（記録の表示）"
    },
    "budget": {
      "status": "released",
      "label": "予算・支出の基本管理"
    },
    "translation": {
      "status": "released",
      "label": "端末内翻訳（iOS 18以降）"
    },
    "rate-manual": {
      "status": "released",
      "label": "旅行ごとのレートを自分で入力（為替の自動取得はしない）。保存済みの記録は保存時のレートのまま",
      "$note": "src/app/rate-setup.tsx（手入力・画面の注記「すでに保存した記録の円換算額は、保存した時点のレートのまま変わりません」）。src に為替を取りに行く通信は無い（fetch は未公開の AI 中継だけ）。2026-11-24 確認"
    },
    "spending-summary": {
      "status": "released",
      "label": "分析：購入済みの合計・月別の購入済み金額・旅行別（無料）",
      "$note": "src/app/(tabs)/analytics.tsx。無料版と Pro の違いはカテゴリー別の集計だけ（pro-analytics）。2026-11-24 確認"
    },
    "pro-unlimited": {
      "status": "released",
      "label": "Pro：保存無制限・複数旅行"
    },
    "pro-analytics": {
      "status": "released",
      "label": "Pro：カテゴリー絞り込み・分析"
    },
    "pro-csv": {
      "status": "released",
      "label": "Pro：CSV書き出し"
    },
    "proplus-map": {
      "status": "planned",
      "label": "Pro+：買い物マップ（未公開）"
    },
    "proplus-schedule": {
      "status": "planned",
      "label": "Pro+：旅行スケジュール（未公開）"
    },
    "proplus-ai-translation": {
      "status": "planned",
      "label": "Pro+：AI翻訳・音声翻訳（未公開）"
    }
