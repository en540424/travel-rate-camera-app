  "capture": {
    "projectRoot": "../../../..",
    "clock": "2026-11-21T10:00:00+09:00",
    "timezone": "Asia/Tokyo",
    "web": {
      "viewport": {
        "width": 440,
        "height": 956,
        "scale": 3
      }
    },
