{
  "$comment": "旅レートカメラの素材生成設定。エンジン（../../engine）はアプリ非依存で、アプリ固有の値はすべてここに置く。features.status が released 以外の機能は、どの文言にも使えない（エンジンが拒否する）。 文言・並びは下書き（Human の採用待ち）。App Store 提出の確定版は Vault の提出パッケージ（AI_CONTEXT.md 参照）。",
  "app": {
    "id": "tabirate",
    "name": {
      "ja": "旅レートカメラ"
    },
    "bundleId": "com.estep.travelratecamera",
    "scheme": "travelratecameraapp"
  },
  "locales": [
    "ja"
  ],
  "localeTags": {
    "ja": "ja-JP"
  },
  "brand": {
    "primary": "#0E9488",
    "primaryDark": "#0A766E",
    "primarySoft": "#E7F5F2",
    "background": "#E7F5F2",
    "backgroundAlt": "#FFFFFF",
    "text": "#16211F",
    "body": "#5B6764",
    "icon": "../../../../assets/images/icon.png",
    "deep": "#0B7F75",
    "deepAlt": "#08524D",
    "onDeepAccent": "#A8EDE2",
    "warm": "#FBF1DE",
    "accentSoft": "#FBF1DE",
    "accentText": "#9A6516"
  },
  "outDir": "../../out",
  "draftWatermark": "DRAFT · Web版プレビュー · 提出不可",
  "features": {
    "camera-ocr": {
      "status": "released",
      "label": "カメラで値札の価格を読み取る（端末内OCR）"
    },
    "jpy-conversion": {
      "status": "released",
      "label": "日本円への換算"
    },
    "multi-currency": {
      "status": "released",
      "label": "複数通貨"
    },
    "manual-convert": {
      "status": "released",
      "label": "手入力の換算"
    },
    "records": {
      "status": "released",
      "label": "買い物候補・購入済みの記録"
    },
    "trips": {
      "status": "released",
      "label": "旅行ごとの記録"
    },
    "calendar": {
      "status": "released",
      "label": "買い物カレンダー（記録の表示）"
    },
    "budget": {
      "status": "released",
      "label": "予算・支出の基本管理"
    },
    "translation": {
      "status": "released",
      "label": "端末内翻訳（iOS 18以降）"
    },
    "pro-unlimited": {
      "status": "released",
      "label": "Pro：保存無制限・複数旅行"
    },
    "pro-analytics": {
      "status": "released",
      "label": "Pro：カテゴリー絞り込み・分析"
    },
    "pro-csv": {
      "status": "released",
      "label": "Pro：CSV書き出し"
    },
    "proplus-map": {
      "status": "planned",
      "label": "Pro+：買い物マップ（未公開）"
    },
    "proplus-schedule": {
      "status": "planned",
      "label": "Pro+：旅行スケジュール（未公開）"
    },
    "proplus-ai-translation": {
      "status": "planned",
      "label": "Pro+：AI翻訳・音声翻訳（未公開）"
    }
  },
  "capture": {
    "projectRoot": "../../../..",
    "clock": "2026-11-21T10:00:00+09:00",
    "timezone": "Asia/Tokyo",
    "web": {
      "viewport": {
        "width": 440,
        "height": 956,
        "scale": 3
      }
    },
    "ios": {
      "devices": [
        "iPhone 17 Pro Max",
        "iPhone 17"
      ],
      "appearance": "light",
      "statusBar": {
        "time": "9:41"
      },
      "fixtureBuild": "build-fixture-db.mjs",
      "dbRelPath": "Documents/SQLite/travelrate.db"
    },
    "screens": [
      {
        "id": "camera",
        "route": "/",
        "deepLink": "travelratecameraapp:///",
        "waitForText": "旅レートカメラ",
        "web": {
          "enabled": false
        },
        "$note": "Web版はカメラ・OCR非対応の表示になるため撮らない。iOSで撮る"
      },
      {
        "id": "smart-camera",
        "route": "/",
        "web": {
          "enabled": false
        },
        "$note": "実機だけ（カメラにかざした値札へ、商品名の翻訳と円の目安が重なる画面）。シミュレーター・CI には実カメラが無いので撮らない（deepLink を持たないのでジョブに入らない）。実機の撮影を import --source device で取り込む"
      },
      {
        "id": "live-translation",
        "route": "/translation",
        "web": {
          "enabled": false
        },
        "$note": "実機だけ（翻訳タブ「ライブ翻訳」で、カメラを向けた文字の近くに訳が重なる画面。iOS 18以降）。シミュレーター・CI では撮らない。2026-10-24 の実機素材は旧表示（「カメラ」「リアルタイム翻訳中」）のため使えない＝現行の版で実機で撮り直す"
      },
      {
        "id": "converter",
        "route": "/converter",
        "deepLink": "travelratecameraapp:///converter",
        "waitForText": "手入力で換算",
        "interact": {
          "$note": "金額を実際の画面操作で入力して撮る（アプリの値を外から書き換えない）。89 EUR × 見本の固定レート165 = ¥14,685（見本の記録「ストール €89」と同じ金額）。入力の後、見出しを押してキーボードを閉じる（ScrollView の keyboardShouldPersistTaps=handled）",
          "driver": "maestro",
          "steps": [
            {
              "tapOn": {
                "id": "converter-amount-input"
              }
            },
            {
              "inputText": "89"
            },
            {
              "tapOn": "手入力で換算"
            },
            {
              "waitForAnimationToEnd": {
                "timeout": 3000
              }
            }
          ],
          "expectVisible": [
            "¥14,685"
          ],
          "expectNotVisible": [
            "金額を入力してください"
          ],
          "timeoutSeconds": 300
        }
      },
      {
        "id": "history",
        "route": "/history",
        "deepLink": "travelratecameraapp:///history",
        "waitForText": "履歴",
        "expectVisible": [
          "マカロン 6個入り",
          "¥129,639"
        ]
      },
      {
        "id": "trip-list",
        "route": "/trip-list",
        "deepLink": "travelratecameraapp:///trip-list",
        "waitForText": "旅行",
        "$note": "終了した旅行2件を含む（テストデータ）",
        "expectVisible": [
          "パリ旅行",
          "ソウル旅行"
        ]
      },
      {
        "id": "calendar",
        "route": "/calendar",
        "deepLink": "travelratecameraapp:///calendar",
        "settleMs": 5000,
        "$settleNote": "第6回（run 45169001221）は旅行一覧の後に開いて2秒で撮り、遷移が間に合わず旅行一覧を写した（原因は推定・未特定）。緩和として待ちを5秒にする。取り違えは job-ingest の見た目の比較で外れる",
        "waitForText": "買い物カレンダー",
        "expectVisible": [
          "買い物カレンダー",
          "¥20,361"
        ]
      },
      {
        "id": "analytics",
        "route": "/analytics",
        "deepLink": "travelratecameraapp:///analytics",
        "expectVisible": [
          "の購入済み金額"
        ],
        "$note": "提出パッケージ §E-1 の5・7枚目（分析）の素材。「分析」はタブの名前にもあるので、画面固有の見出しで確かめる"
      },
      {
        "id": "pro-features",
        "route": "/pro-features",
        "deepLink": "travelratecameraapp:///pro-features",
        "waitForText": "無料版とProの違い",
        "expectVisible": [
          "無料版とProの違い"
        ]
      },
      {
        "id": "help",
        "route": "/help",
        "deepLink": "travelratecameraapp:///help",
        "waitForText": "使い方"
      },
      {
        "id": "translation",
        "route": "/translation",
        "deepLink": "travelratecameraapp:///translation",
        "web": {
          "enabled": false
        },
        "$note": "Web版は「翻訳を利用できません」になる。iOSでは入力の画面だけを撮る（翻訳の実行は言語のダウンロードの窓が出得るため自動では行わない。結果の画面は実機で撮る）",
        "expectVisible": [
          "翻訳する"
        ],
        "expectNotVisible": [
          "翻訳を利用できません"
        ]
      },
      {
        "id": "rate-setup",
        "route": "/rate-setup",
        "deepLink": "travelratecameraapp:///rate-setup",
        "expectVisible": [
          "現在のレート",
          "換算プレビュー"
        ],
        "$note": "提出パッケージ §E-1 の4枚目（レートは自分で設定＝自動取得と誤解させない）の素材。文言（shot）は Human の判断の後に足す。この画面はアプリで modal（src/app/_layout.tsx）。撮影はこの並びの順で、modal の後に開いた通常の画面は modal の上のシートとして表示される（利用者が見る全画面の表示と違う）ため、操作の無い画面の最後に置く（fixture.test.mjs で検査）。タブの画面（翻訳）の直後なので、背後は通常の画面"
      }
    ]
  },
  "shots": [
    {
      "id": "01-camera",
      "screen": "camera",
      "features": [
        "camera-ocr",
        "jpy-conversion"
