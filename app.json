{
  "expo": {
    "name": "旅レートカメラ",
    "slug": "travel-rate-camera-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "travelratecameraapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.estep.travelratecamera",
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "カメラで価格タグを撮影して円換算します"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "カメラロールの画像を買い物候補に紐付けます"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "音声入力で話した内容を翻訳するためにマイクを使用します",
          "speechRecognitionPermission": "話した内容を文字に変換して翻訳するために音声認識を使用します"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "55a47509-fb49-448f-ac03-5436b1b10a1e"
      }
    },
    "owner": "en540424"
  }
}
