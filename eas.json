{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "resourceClass": "default"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "resourceClass": "default"
      }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "ios": {
        "resourceClass": "default"
      }
    },
    "testflight-proplus-qa": {
      "extends": "production",
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_PRO_PLUS_QA": "1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
